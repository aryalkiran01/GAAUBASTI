# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/gaunbasti

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Payment provider configuration
# Set to "stripe" for real payments. "mock" is not allowed in production.
PAYMENT_PROVIDER=stripe
# Stripe (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# eSewa (Nepal digital wallet) — server-side only, never expose to frontend
ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_ENVIRONMENT=sandbox

# Email (SMTP) — required for transactional emails
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Gaun Basti

# SMS (Twilio) — required for OTP and safety alerts via SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AI Configuration
# Provider: "gemini" (Google Gemini, cloud) or "ollama" (local/development)
AI_PROVIDER=gemini
# Enable automatic fallback to the other provider when the primary fails
AI_FALLBACK_ENABLED=true
# Request timeout in milliseconds
AI_TIMEOUT_MS=30000
# Rate limiting for AI endpoints
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# Google Gemini (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Ollama (required when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1