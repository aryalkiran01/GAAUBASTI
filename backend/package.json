{
  "name": "gaunbasti-backend",
  "version": "1.0.0",
  "description": "Backend API for Gaunbasti rural tourism platform",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "seed": "node --import tsx scripts/seedData.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.40.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^1.0.0",
    "nodemailer": "^7.0.6",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.1",
    "@types/compression": "^1.7.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.13.0",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "nodemon": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0"
  },
  "keywords": [
    "tourism",
    "homestay",
    "nepal",
    "rural",
    "api"
  ],
  "author": "Gaunbasti Team",
  "license": "MIT"
}
